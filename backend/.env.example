# Copy to backend/.env and fill in. Never commit backend/.env or seamo.json.
PORT=5000
# Bind address. Use 127.0.0.1 behind nginx so the port is not reachable from the internet.
HOST=0.0.0.0
CORS_ORIGIN=*

# Google Cloud service-account JSON (Translation API), path relative to this folder.
GOOGLE_APPLICATION_CREDENTIALS=seamo.json
GOOGLE_PROJECT_ID=your-gcp-project-id

# Deepgram live speech-to-text.
DEEPGRAM_API_KEY=
# Optional: force a model (default: nova-3 for English, nova-2 otherwise).
# DEEPGRAM_MODEL=nova-3
# Leave unset. 300 made Deepgram return empty finals and drop sentences in testing.
# DEEPGRAM_ENDPOINTING_MS=

# Speaker login (checked server-side). Generate a long random password.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
# Random 64-hex string; keeps speaker sessions valid across restarts.
ADMIN_TOKEN_SECRET=
ADMIN_TOKEN_TTL_HOURS=24

# Whether the in-room presentation display may pause the microphone while it plays audio.
PAUSE_FROM_DISPLAY=true
